# Password for the whole site, and for the nutrition upload API (Authorization: Bearer ...).
DASHBOARD_PASSWORD=

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Neon or Vercel Postgres. POSTGRES_URL is also accepted.
DATABASE_URL=

# WHOOP personal app. The refresh token is rotated and then stored in oauth_tokens.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REFRESH_TOKEN=

# Garmin Connect Personal API key. Sent as Authorization: ApiKey <key>.
GARMIN_PERSONAL_API_KEY=

# Days to pull after the first run. The first pull, on an empty database, always backfills 30.
SYNC_LOOKBACK_DAYS=7
